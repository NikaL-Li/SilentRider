# 译路畅通 · 环境变量示例
# 复制：sudo -u ylct cp deploy/ylct.env.example /opt/ylct/.env
# 权限：sudo chmod 600 /opt/ylct/.env

# ── MiMo TTS（不填则前端回退浏览器语音） ──
MIMO_API_KEY=
MIMO_VOICE=冰糖

# ── 监听 ──
# 前面有 Nginx 时保持 127.0.0.1，由 Nginx 转发；
# 本机直接访问改成 0.0.0.0 才能被局域网访问（不推荐公网直连）。
YLCT_HOST=127.0.0.1
YLCT_PORT=8818

# ── 数据 ──
# SQLite 数据库、WAL 都在这个目录；必须让运行用户可写。
YLCT_DATA_DIR=/var/lib/ylct
# 也可以单独指定数据库文件：
# YLCT_DB=/var/lib/ylct/app.db

# ── 反向代理 / Cookie ──
# 1 = 信任 X-Forwarded-For / X-Forwarded-Proto（仅 Nginx 已覆盖可信头时开启）
# 默认 0；Cloudflare Tunnel 直连或无法保证代理覆盖时不要开，否则可伪造 IP 绕过限流
YLCT_TRUST_PROXY=0
# auto / 1 / 0；auto 表示按 X-Forwarded-Proto 自动决定 Secure
YLCT_COOKIE_SECURE=auto

# ── 短信验证码登录（默认关闭） ──
# none / console / webhook
# console：验证码打印到 journalctl，适合本机演示
# webhook：POST 到自己的短信网关
YLCT_SMS_PROVIDER=none
# YLCT_SMS_WEBHOOK=https://your-sms-gateway.example.com/send
# YLCT_SMS_TOKEN=change-me
# 1 = 把验证码直接返回给页面（只在本机演示时打开，公网务必 0）
YLCT_SMS_DEBUG=0

# ── 服务器语音外呼（默认关闭） ──
# 指向自己的语音网关，见 docs/电话播报方案.md
# YLCT_CALL_WEBHOOK=https://your-gateway.example.com/call
# YLCT_CALL_TOKEN=change-me
# 1 = 外呼必须登录（默认 1；开放给游客会产生骚扰/费用风险）
YLCT_CALL_REQUIRE_LOGIN=1

# ── 高德 Web服务 Key（服务端用；不要放前端） ──
# 用于逆地理编码、IP 定位、天气
AMAP_KEY=

# ── 截图 OCR（需要 tesseract-ocr + tesseract-ocr-chi-sim） ──
YLCT_OCR_LANG=chi_sim+eng

# ── 远程 OCR（可选；性能更好的机器跑 ocr-service） ──
# 例如 https://ocr.example.com/ocr 或 http://127.0.0.1:19000/ocr（SSH 反向隧道）
OCR_REMOTE_URL=
OCR_REMOTE_TOKEN=
OCR_REMOTE_TIMEOUT=4

# ── 腾讯云 OCR（云端主识别） ──
OCR_PROVIDER=tencent
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
